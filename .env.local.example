# Giscus comment system configuration
# Get these from https://giscus.app after enabling Discussions on your repo
NEXT_PUBLIC_GISCUS_REPO=tabeen/tabeen.dev
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Comments
NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# Optional — set to "alt" to preview the proposed alternate logo mark
# (a horizontal row of varying-size paired ovals) instead of the default
# 3x3 dot grid. Unset/anything else keeps the default mark.
NEXT_PUBLIC_LOGO_VARIANT=
